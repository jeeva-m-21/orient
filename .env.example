# Orient (Sightline) Environment Configuration Example
# Copy to .env for local overrides if needed. Orient defaults to 100% local operation without external keys.

# Daemon Configuration
PORT=4477
HOST=127.0.0.1
NODE_ENV=development

# Optional Fallback LLM API (if user chooses cloud fallback over local Ollama / Agent writeback)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Debug & Audit Log Level (trace, debug, info, warn, error)
LOG_LEVEL=info
