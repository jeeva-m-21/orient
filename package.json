{
  "name": "orient-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run packages/core",
    "test:extractors": "vitest run packages/extractors",
    "test:daemon": "vitest run packages/daemon",
    "test:cli": "vitest run packages/cli",
    "test:schema": "vitest run packages/schema",
    "lint": "eslint .",
    "clean": "pnpm --recursive --filter \"./packages/*\" run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^10.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8"
  }
}
