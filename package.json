{
  "name": "orient-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "typecheck": "pnpm --recursive --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "pnpm --recursive --filter \"./packages/*\" run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^10.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8"
  }
}
